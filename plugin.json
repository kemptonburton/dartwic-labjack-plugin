{
  "id": "labjack_t7",
  "name": "LabJack T7 Plugin",
  "description": "LabJack T7 discovery, streaming, and digital output integration for DARTWIC.",
  "author": "Kempton Burton",
  "version": "1.0.0",
  "minEngineVersion": "2.0.0-beta.3",
  "minInterfaceVersion": "2.0.0-beta.3",
  "contains_engine_plugin": true,
  "contains_interface_plugin": true,
  "device_discovery": {
    "enabled": true,
    "scan_interval_seconds": 3,
    "suggest_analog_inputs": true,
    "analog_input_start": 0,
    "analog_input_end": 13,
    "digital_io_start": 0,
    "digital_io_end": 22
  }
}
